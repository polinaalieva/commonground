{
  "redirects": [
    { "source": "/", "destination": "/map", "permanent": false },
    { "source": "/ru", "destination": "/ru/map", "permanent": false },
    { "source": "/qr", "destination": "/map", "permanent": false }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/ru/about", "destination": "/about.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/about",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/ru/about",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
