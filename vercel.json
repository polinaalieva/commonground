{
  "redirects": [
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/ru/about", "destination": "/", "permanent": true },
    { "source": "/event", "destination": "/map", "permanent": false },
    { "source": "/ru/event", "destination": "/ru/map", "permanent": false },
    { "source": "/ru", "destination": "/ru/map", "permanent": false },
    { "source": "/qr", "destination": "/map", "permanent": false },
    { "source": "/event/uis27", "destination": "/event/uis-09-27", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
